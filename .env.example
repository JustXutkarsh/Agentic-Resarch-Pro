# ==============================================================================
# Agentic Research PRO - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and provide your API keys before running.
# Never commit .env or real API keys to version control.
# ==============================================================================

# Server & Network Configuration
PORT=8000
# Comma-separated allowed origins (e.g., "https://my-app.onrender.com,http://localhost:5173")
# Leave empty to allow default localhost origins for local development.
CORS_ALLOW_ORIGINS=

# Primary LLM Provider: NVIDIA NIM (Nemotron)
# Obtain key from https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_PROVIDER=nvidia

# Embedding Provider: "nvidia" (remote NIM API, 2048-dim, recommended for 512MB RAM) or "local" (MiniLM, 384-dim)
EMBEDDING_PROVIDER=nvidia
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_BATCH_SIZE=16

# Fallback LLM Provider: OpenAI (Safety Net)
# Used automatically if NVIDIA NIM encounters exhausted rate limits or downtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web Search Provider: Tavily API
# Obtain key from https://tavily.com
TAVILY_API_KEY=

# Vector Storage (ChromaDB)
# Leave empty for default in-memory EphemeralClient (recommended for Render free tier).
# Optional persistent directory path if using persistent disk storage.
CHROMA_PERSIST_DIR=

# Playwright Browser Acquisition Agent
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_PAGES=3
PLAYWRIGHT_MAX_SCROLLS=5
PLAYWRIGHT_TIMEOUT_MS=15000
